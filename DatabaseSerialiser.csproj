<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DatabaseSerialiser</RootNamespace>
    <AssemblyName>DatabaseSerialiser</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.CommandLineUtils" Version="1.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include=".github\upgrades\scenarios\dotnet-version-upgrade\final-report.md" />
    <None Include=".github\upgrades\scenarios\dotnet-version-upgrade\tasks\02-update-tfms-and-project-file\progress-details.md" />
    <None Include=".github\upgrades\scenarios\dotnet-version-upgrade\tasks\07-finalize-and-cleanup\progress-details.md" />
    <None Include="App.config" />
    <None Include="TestConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
</Project>